# Phase-1 model outputs -- regenerated by src/run_phase1.py. Not committed,
# so a --synthetic run can never be mistaken for a real result.
data/processed/domain_weights.csv
data/processed/model_scorecard.csv
data/processed/gravity_coefficients.csv

# API keys -- never commit these
.env

# IPUMS extracts are large and re-fetchable via src/fetch_data.py
data/raw/*.csv.gz
data/raw/*.dat.gz
data/raw/*.xml
data/raw/ipums_extract.json

# Phase-2 outputs -- regenerated by src/run_phase2.py
data/processed/model_comparison*.csv
data/processed/mobility_deserts*.csv
data/processed/universe_comparison.csv

# O*NET bulk dumps are ~99 MB unpacked and reproducible from a documented
# download. `python src/fetch_data.py onet --download 31.0` fetches one;
# build_master.py turns it into the 1.2 MB parquet the pipeline reads.
data/raw/onet_31_0/
