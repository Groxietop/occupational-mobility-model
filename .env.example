# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# https://account.ipums.org/api_keys
# Requires a separate per-collection registration for CPS:
# https://uma.pop.umn.edu/cps/registration/new
IPUMS_API_KEY=

# https://services.onetcenter.org/developer/signup
# Used only to detect that the committed bulk database has gone stale, and
# for single-occupation spot checks. The feature matrix still comes from the
# bulk download -- see src/sources/onet.py for why.
ONET_API_KEY=
